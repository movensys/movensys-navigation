<?xml version="1.0"?>
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<gazebo reference="lidar_front_left_link">
		<sensor name="lidar_front_left_sensor" type="gpu_lidar">
			<pose>0 0 0 0 0 0</pose>
			<always_on>true</always_on>
			<visualize>false</visualize>
			<update_rate>35</update_rate>
			<topic>/lidar_front_left_scan</topic>
			<gz_frame_id>ray_front_left_link</gz_frame_id>
			<lidar>
				<scan>
					<horizontal>
						<samples>1080</samples>
						<resolution>1</resolution>
						<min_angle>-2.0943951023931953</min_angle>
						<max_angle>2.0943951023931953</max_angle>
					</horizontal>
				</scan>
				<range>
					<min>0.1</min>
					<max>30.0</max>
					<resolution>0.01</resolution>
				</range>
				<noise>
					<type>gaussian</type>
					<mean>0.0</mean>
					<stddev>0.01</stddev>
				</noise>
			</lidar>
		</sensor>
	</gazebo>

	<gazebo reference="lidar_rear_right_link">
		<sensor name="lidar_rear_right_sensor" type="gpu_lidar">
			<pose>0 0 0 0 0 0</pose>
			<always_on>true</always_on>
			<visualize>false</visualize>
			<update_rate>35</update_rate>
			<topic>/lidar_rear_right_scan</topic>
			<gz_frame_id>ray_rear_right_link</gz_frame_id>
			<lidar>
				<scan>
					<horizontal>
						<samples>1080</samples>
						<resolution>1</resolution>
						<min_angle>-2.0943951023931953</min_angle>
						<max_angle>2.0943951023931953</max_angle>
					</horizontal>
				</scan>
				<range>
					<min>0.1</min>
					<max>30.0</max>
					<resolution>0.01</resolution>
				</range>
				<noise>
					<type>gaussian</type>
					<mean>0.0</mean>
					<stddev>0.01</stddev>
				</noise>
			</lidar>
		</sensor>
	</gazebo>

	<gazebo reference="imu_link">
		<gravity>true</gravity>
		<sensor name="imu_sensor" type="imu">
			<always_on>true</always_on>
			<update_rate>50</update_rate>
			<topic>/imu</topic>
			<gz_frame_id>value_link</gz_frame_id>
			<imu>
				<angular_velocity>
					<x><noise type="gaussian"><mean>0</mean><stddev>0.00278</stddev></noise></x>
					<y><noise type="gaussian"><mean>0</mean><stddev>0.00278</stddev></noise></y>
					<z><noise type="gaussian"><mean>0</mean><stddev>0.00278</stddev></noise></z>
				</angular_velocity>
				<linear_acceleration>
					<x><noise type="gaussian"><mean>0</mean><stddev>0.00278</stddev></noise></x>
					<y><noise type="gaussian"><mean>0</mean><stddev>0.00278</stddev></noise></y>
					<z><noise type="gaussian"><mean>0</mean><stddev>0.00278</stddev></noise></z>
				</linear_acceleration>
			</imu>
		</sensor>
	</gazebo>

	<joint name="camera_front_infra1_optical_joint" type="fixed">
		<parent link="camera_front_link"/>
		<child link="camera_front_infra1_optical_frame"/>
		<origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
	</joint>

	<link name="camera_front_infra1_optical_frame">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<box size="0.001 0.001 0.001"/>
			</geometry>
		</visual>
	</link>

	<joint name="camera_front_infra2_optical_joint" type="fixed">
		<parent link="camera_front_link"/>
		<child link="camera_front_infra2_optical_frame"/>
		<origin xyz="0 -0.095 0" rpy="-1.5707963 0 -1.5707963"/>
	</joint>

	<link name="camera_front_infra2_optical_frame">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<box size="0.001 0.001 0.001"/>
			</geometry>
		</visual>
	</link>

	<gazebo reference="camera_front_link">
		<sensor name="camera_front_infra1_sensor" type="camera">
			<pose>0 0 0 0 0 0</pose>
			<always_on>true</always_on>
			<visualize>false</visualize>
			<update_rate>30</update_rate>
			<topic>/image_front_infra1/rgb</topic>
			<gz_frame_id>camera_front_infra1_optical_frame</gz_frame_id>
			<camera>
				<horizontal_fov>1.518</horizontal_fov>
				<image>
					<width>640</width>
					<height>360</height>
					<format>L8</format>
				</image>
				<clip>
					<near>0.1</near>
					<far>30.0</far>
				</clip>
			</camera>
		</sensor>

		<sensor name="camera_front_infra2_sensor" type="camera">
			<pose>0 -0.095 0 0 0 0</pose>
			<always_on>true</always_on>
			<visualize>false</visualize>
			<update_rate>30</update_rate>
			<topic>/image_front_infra2/rgb</topic>
			<gz_frame_id>camera_front_infra2_optical_frame</gz_frame_id>
			<camera>
				<horizontal_fov>1.518</horizontal_fov>
				<image>
					<width>640</width>
					<height>360</height>
					<format>L8</format>
				</image>
				<clip>
					<near>0.1</near>
					<far>30.0</far>
				</clip>
			</camera>
		</sensor>
	</gazebo>

	<gazebo reference="drivewheel_left">
		<collision>
			<surface>
				<friction>
					<ode>
						<mu>1.0</mu>
						<mu2>1.0</mu2>
						<fdir1>1 0 0</fdir1>
					</ode>
				</friction>
				<contact>
					<ode>
						<kp>10000000.0</kp>
						<kd>1.0</kd>
					</ode>
				</contact>
			</surface>
		</collision>
		<material>
			<ambient>0 0 0 1</ambient>
			<diffuse>0 0 0 1</diffuse>
		</material>
	</gazebo>

	<gazebo reference="drivewheel_right">
		<collision>
			<surface>
				<friction>
					<ode>
						<mu>1.0</mu>
						<mu2>1.0</mu2>
						<fdir1>1 0 0</fdir1>
					</ode>
				</friction>
				<contact>
					<ode>
						<kp>10000000.0</kp>
						<kd>1.0</kd>
					</ode>
				</contact>
			</surface>
		</collision>
		<material>
			<ambient>0 0 0 1</ambient>
			<diffuse>0 0 0 1</diffuse>
		</material>
	</gazebo>

	<gazebo reference="base_link">
		<collision>
			<surface>
				<friction>
					<ode>
						<mu>1.0</mu>
						<mu2>1.0</mu2>
						<fdir1>1 0 0</fdir1>
					</ode>
				</friction>
				<contact>
					<ode>
						<kp>10000000.0</kp>
						<kd>1.0</kd>
					</ode>
				</contact>
			</surface>
		</collision>
		<material>
			<ambient>0 0 0 1</ambient>
			<diffuse>0 0 0 1</diffuse>
		</material>
	</gazebo>

	<gazebo reference="castor_rear_right">
		<collision>
			<surface>
				<friction>
					<ode>
						<mu>0.0</mu>
						<mu2>0.0</mu2>
					</ode>
				</friction>
				<contact>
					<ode>
						<kp>10000000.0</kp>
						<kd>1.0</kd>
					</ode>
				</contact>
			</surface>
		</collision>
		<material>
			<ambient>0 0 0 1</ambient>
			<diffuse>0 0 0 1</diffuse>
		</material>
	</gazebo>

	<gazebo reference="castor_rear_left">
		<collision>
			<surface>
				<friction>
					<ode>
						<mu>0.0</mu>
						<mu2>0.0</mu2>
					</ode>
				</friction>
				<contact>
					<ode>
						<kp>10000000.0</kp>
						<kd>1.0</kd>
					</ode>
				</contact>
			</surface>
		</collision>
		<material>
			<ambient>0 0 0 1</ambient>
			<diffuse>0 0 0 1</diffuse>
		</material>
	</gazebo>

</robot>
